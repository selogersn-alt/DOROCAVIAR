# ==============================================================================
# CONFIGURATION DORO CAVIAR - ENVIRONNEMENT PRODUCTION & DÉVELOPPEMENT
# ==============================================================================
# Copiez ce fichier sous le nom ".env" à la racine de votre projet.
# Remplissez les clés de production pour votre déploiement.

# ------------------------------------------------------------------------------
# 1. PARAMÈTRES GENERAUX & SECURITE
# ------------------------------------------------------------------------------
# Mettre à "False" en production
DEBUG=False

# Générez une clé secrète forte (ex: avec openssl rand -hex 32)
SECRET_KEY=votre_cle_secrete_hyper_longue_et_aleatoire_ici

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,dorocaviar.com,www.dorocaviar.com,*.ondigitalocean.app

# Origines de confiance pour la sécurité CSRF sous Cloudflare/Reverse proxy
# Obligatoire en production pour autoriser la validation de formulaires
CSRF_TRUSTED_ORIGINS=https://dorocaviar.com,https://www.dorocaviar.com,https://*.ondigitalocean.app

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (POSTGRESQL)
# ------------------------------------------------------------------------------
# Format : postgres://utilisateur:mot_de_passe@hote:port/nom_base
DATABASE_URL=postgres://db_user:db_password@localhost:5432/dorocaviar_db

# ------------------------------------------------------------------------------
# 3. CACHE ET MOTEUR DE SESSIONS (REDIS)
# ------------------------------------------------------------------------------
# Requis pour les statistiques, l'historique et les sessions fluides
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. STOCKAGE CLOUD & CDN (BUNNY.NET STORAGE & BUNNYCDN)
# ------------------------------------------------------------------------------
# Activer l'hébergement cloud Bunny.net (True / False)
USE_BUNNY=True

# Le nom de votre zone de stockage Bunny.net
BUNNY_STORAGE_ZONE_NAME=dorocaviar-storage

# Le mot de passe d'accès S3 de votre zone de stockage Bunny (obtenu dans Bunny.net)
BUNNY_STORAGE_PASSWORD=votre_mot_de_passe_de_zone_de_stockage_ici

# URL Endpoint de stockage Bunny (la.storage.bunnycdn.com ou storage.bunnycdn.com)
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com

# Le domaine de votre Pull Zone BunnyCDN (ex: dorocaviar.b-cdn.net)
BUNNY_CDN_DOMAIN=dorocaviar.b-cdn.net

# Activer aussi le CDN Bunny pour les fichiers statiques (CSS, JS) (True / False)
USE_BUNNY_STATIC=True

# ------------------------------------------------------------------------------
# 5. EMAILS (SENDGRID)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.votre_cle_api_sendgrid_ici
DEFAULT_FROM_EMAIL=noreply@dorocaviar.com
